# Copy this file to `.env` and adjust the values. Never commit `.env`.

# --- Application ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL container (docker-compose.yml) ---
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow
POSTGRES_PORT=5432

# --- Prisma / application database connection ---
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public
